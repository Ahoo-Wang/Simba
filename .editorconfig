# Coding conventions shared by editors and ktlint (detekt-formatting).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false

[*.{yml,yaml,json,md,ts,mjs,vue,css,lua}]
indent_size = 2

[*.lua]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{gradlew,gradlew.bat}]
trim_trailing_whitespace = false
